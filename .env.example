# ── Database (Neon serverless Postgres) ───────────────────────────────
# Use the POOLED connection string from the Neon dashboard.
# Format: postgresql://USER:PASSWORD@HOST/DB?sslmode=require
DATABASE_URL="postgresql://user:password@host.neon.tech/bookingapp?sslmode=require"

# ── Auth.js (NextAuth v5) ─────────────────────────────────────────────
# Generate one with: npx auth secret   (or: openssl rand -base64 32)
AUTH_SECRET="replace-me-with-a-long-random-string"
# Set in production to your deployed origin, e.g. https://bookingapp.vercel.app
# AUTH_URL="http://localhost:3000"

# ── Email (Resend) — used from Phase 2+ ───────────────────────────────
# RESEND_API_KEY=""

# ── Build/CI escape hatch ─────────────────────────────────────────────
# Set to 1 to skip Zod env validation during builds without real secrets.
# SKIP_ENV_VALIDATION="1"
